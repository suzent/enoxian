#!/usr/bin/env python3
"""Server-side write permissions for the integration repo of one run.

Installed as hooks/pre-receive in each run's bare repo, served by the `git`
container (git daemon), which no device can reach as files. A push may change
only the package its device owns (owners.json next to the repo, as in
meta.json `owners`; a device listed as "*" may change anything). The pushing
device is the one whose compose hostname resolves to REMOTE_ADDR, which git
daemon sets; ENOXIAN_DEVICE_LABEL is used only when there is none (a local
push in tests). Every push, accepted or not, is appended to pushes.jsonl for
the harness to read.
"""

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

repo = Path.cwd()
owners = json.loads((repo.parent / "owners.json").read_text())


def device_of(addr: str) -> str:
    for d in "ABC":
        try:
            if socket.gethostbyname(f"dev-{d.lower()}") == addr:
                return d
        except OSError:
            pass
    return "?"


addr = os.environ.get("REMOTE_ADDR")
device = device_of(addr) if addr else os.environ.get("ENOXIAN_DEVICE_LABEL", "?")
own = owners.get(device)
log = repo.parent / "pushes.jsonl"
zero = "0" * 40
status = 0

for line in sys.stdin:
    old, new, ref = line.split()
    reason = None
    if (repo.parent / "frozen").exists():
        reason = "the run has ended; main is frozen"
    elif new == zero:
        reason = "deleting a branch is not allowed"
    elif ref != "refs/heads/main":
        reason = f"only main is shared; push {ref} is refused"
    elif own is None:
        reason = f"device {device} has no write permission"
    elif own != "*":
        changed = subprocess.run(
            ["git", "diff", "--name-only", old, new] if old != zero
            else ["git", "diff-tree", "-r", "--name-only", "--no-commit-id", "--root", new],
            capture_output=True, text=True, check=True,
        ).stdout.split()
        foreign = [p for p in changed if not p.startswith(own + "/")]
        if foreign:
            reason = f"device {device} may change only {own}/; this push changes {', '.join(foreign[:5])}"
    with log.open("a") as f:
        f.write(json.dumps({
            "ts": time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime()) + f".{int(time.time() * 1000) % 1000:03d}Z",
            "device": device,
            "kind": "git_push_rejected" if reason else "git_push",
            "payload": {"branch": ref, "commit": new, "old": old, "reason": reason},
        }) + "\n")
    if reason:
        print(f"refused: {reason}", file=sys.stderr)
        status = 1

sys.exit(status)
