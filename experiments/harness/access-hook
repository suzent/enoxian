#!/usr/bin/env python3
"""git daemon --access-hook: who may read or write which repo.

Called as: access-hook <service> <path> <host> <canonical host> <ip> <port>,
where <ip> is the server's own address; the caller's is REMOTE_ADDR. The
caller is the device whose compose hostname resolves to it, which nothing the
agent controls. In Silent each device has a repo of its own under /srv/git/<D>/
and may reach only that one; elsewhere every device shares /srv/git/origin.git.
"""

import os
import socket
import sys
from pathlib import Path

service, path, ip = sys.argv[1], sys.argv[2], os.environ.get("REMOTE_ADDR", "")


def device_of(addr: str) -> str | None:
    for d in "ABC":
        try:
            if socket.gethostbyname(f"dev-{d.lower()}") == addr:
                return d
        except OSError:
            pass
    return None


device = device_of(ip)
if device is None:
    print(f"refused: {ip} is not a device", file=sys.stderr)
    sys.exit(1)
rel = Path(path).resolve().relative_to(Path("/srv/git").resolve())
owner = rel.parts[0] if len(rel.parts) > 1 else None  # "A/origin.git" -> "A"
if owner is not None and owner != device:
    print(f"refused: device {device} may not reach {rel}", file=sys.stderr)
    sys.exit(1)
