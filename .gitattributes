# Normalize line endings in the repository. Without this, a contributor with
# core.autocrlf=true can commit CRLF into scripts/install.sh, which CI's `sh -n`
# accepts but a user's shell rejects at the shebang.
* text=auto

*.sh text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.ps1 text eol=crlf

Cargo.lock linguist-generated=true
frontend/package-lock.json linguist-generated=true
